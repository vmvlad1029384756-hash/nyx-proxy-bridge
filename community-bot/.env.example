# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional: role ID allowed to receive support tickets (Support or Admin role)
SUPPORT_ROLE_ID=

# Optional: absolute or relative persistent data directory
DATA_DIR=./data

# Optional channel banner URLs (direct HTTPS image URLs)
BANNER_WELCOME=
BANNER_RULES=
BANNER_PROJECTS=
BANNER_ANNOUNCEMENTS=
BANNER_ROADMAP=
BANNER_UPDATES=
BANNER_SUPPORT=
BANNER_PARTNERS=

# Optional JSON object mapping panel keys to direct HTTPS image URLs.
# Example: BANNERS_JSON={"welcome":"https://.../welcome.png","rules":"https://.../rules.png"}
BANNERS_JSON={}
